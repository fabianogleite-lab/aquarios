# ⚗ AquariOS Backend V2.0000 — Environment Configuration

# DATABASE
DATABASE_URL="postgresql://aquarios_user:secure_password@localhost:5432/aquarios_v2"
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# REDIS (Cache + Sessions)
REDIS_URL="redis://localhost:6379"
REDIS_TTL=86400

# JWT & Security
JWT_SECRET="your-super-secure-jwt-secret-min-64-chars-change-in-production"
JWT_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"
ENCRYPTION_KEY="your-aes-256-key-min-64-chars-change-in-production"

# API Configuration
NODE_ENV="development"
PORT=3000
API_BASE_URL="http://localhost:3000"
API_VERSION="v2"

# CORS
CORS_ORIGIN="http://localhost:8081,exp://localhost:8081,https://yourdomain.com"

# Anthropic API (for ProteOS fallback)
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxx"
ANTHROPIC_MODEL="claude-opus-4-20250514"

# Logging
LOG_LEVEL="info"
LOG_FILE="logs/aquarios-v2.log"

# Feature Flags
FEATURE_HYGEIOS_ETL=true
FEATURE_ASCLEPIOS_RISK=true
FEATURE_SANDEIROS_OCULTO=true
FEATURE_ECUMENICOS=true
FEATURE_ETERIOS=true
FEATURE_MARKETPLACE=true
FEATURE_BECK_OFFICE=false

# Backup & Archive
BACKUP_ENABLED=true
BACKUP_FREQUENCY="0 2 * * *"
BACKUP_PATH="./backups"

# LGPD Compliance
LGPD_DATA_RETENTION_DAYS=365
LGPD_AUDIT_ENABLED=true
LGPD_ENCRYPTION_ENABLED=true

# Sentry (Error Tracking)
SENTRY_DSN=""
SENTRY_ENABLED=false

# Email (for alerts & notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@aquarios.app"

# Webhook (for EteriOS integrations)
WEBHOOK_SECRET="webhook-secret-min-32-chars"
WEBHOOK_TIMEOUT=5000

# Admin Console
ADMIN_SECRET="admin-console-secret-min-64-chars"
ADMIN_USER_ID="adm_ai"
