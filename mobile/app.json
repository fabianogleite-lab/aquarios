{
  "expo": {
    "name": "AquariOS",
    "slug": "aquarios-274s3k",
    "version": "4.7.0",
    "orientation": "portrait",
    "scheme": "aquarios",
    "icon": "./assets/icon.png",
    "backgroundColor": "#090c14",
    "splash": {
      "backgroundColor": "#090c14",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.arkhe.aquarios",
      "infoPlist": {
        "NSCameraUsageDescription": "AquariOS usa a câmera para personalizar seu perfil e compartilhar momentos na comunidade.",
        "NSMicrophoneUsageDescription": "AquariOS usa o microfone para suporte por voz com ProteOS.",
        "NSLocationWhenInUseUsageDescription": "AquariOS usa sua localização para personalizar recomendações de saúde e bem-estar.",
        "NSCalendarsUsageDescription": "AquariOS integra com seu calendário para lembretes de eventos Wonder Night.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "AquariOS adiciona eventos Wonder Night ao seu calendário.",
        "NSPhotoLibraryUsageDescription": "AquariOS acessa sua galeria para personalizar seu perfil e compartilhar na comunidade.",
        "NSPhotoLibraryAddUsageDescription": "AquariOS salva fotos de progresso na sua galeria.",
        "NSFaceIDUsageDescription": "AquariOS usa Face ID para proteger seu acesso com biometria."
      }
    },
    "android": {
      "package": "com.arkhe.aquarios",
      "versionCode": 47,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090c14"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "cli": {
      "appVersionSource": "nativeVersion"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "eas": {
        "projectId": "d2385f57-b0ab-49f6-a29e-d0d82b92df55"
      }
    },
    "owner": "aquarios",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-camera",
      "expo-image-picker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AquariOS precisa da sua localização para personalizar sua experiência."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#b8952a",
          "sounds": []
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "AquariOS acessa seu calendário para integrar com Google Agenda."
        }
      ],
      "./plugins/withAssistant.js"
    ]
  }
}
