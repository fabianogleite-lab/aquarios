# AquariOS — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)

# ─────────────────────────────────────────────
# Supabase (obrigatório)
# Dashboard: https://supabase.com/dashboard/project/agebsmjsjrmazbozphnh/settings/api
# ─────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://agebsmjsjrmazbozphnh.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ─────────────────────────────────────────────
# EAS Build — adicionar como secrets no Expo:
#   npx eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_URL --value "https://..."
#   npx eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "eyJ..."
# ─────────────────────────────────────────────
