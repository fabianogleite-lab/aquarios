# AquariOS v2.0000 — Environment Variables
# Copy this to .env and fill in actual values

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# ============================================================================
# DATABASE
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=aquarios
DB_PASSWORD=your-secure-password
DB_NAME=aquarios_dev

# ============================================================================
# REDIS (Cache & Sessions)
# ============================================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================================================
# PAYMENT GATEWAYS
# ============================================================================
# Stripe
STRIPE_PUBLIC_KEY=pk_test_xxxx
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Mercado Pago
MERCADO_PAGO_CLIENT_ID=your_client_id
MERCADO_PAGO_CLIENT_SECRET=your_client_secret
MERCADO_PAGO_ACCESS_TOKEN=your_access_token

# Pix (Brasil)
PIX_KEY=your_pix_key
PIX_SECRET=your_pix_secret

# Wise (International transfers)
WISE_API_TOKEN=your_wise_token
WISE_PROFILE_ID=your_profile_id

# ============================================================================
# EXTERNAL APIS
# ============================================================================
# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_CLOUD_VISION_API_KEY=your_vision_key
GOOGLE_CLOUD_SPEECH_API_KEY=your_speech_key

# OpenAI (Whisper + GPT)
OPENAI_API_KEY=sk_xxxx

# Claude (Anthropic)
ANTHROPIC_API_KEY=your_claude_key

# ============================================================================
# AUTHENTICATION
# ============================================================================
JWT_SECRET=your-secret-key-min-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# OAuth2 (Auth0)
AUTH0_DOMAIN=your_domain.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret

# ============================================================================
# EMAIL & MESSAGING
# ============================================================================
# SendGrid
SENDGRID_API_KEY=SG.xxxx

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=+55xxxx

# WhatsApp Business API
WHATSAPP_BUSINESS_ACCOUNT_ID=your_account_id
WHATSAPP_PHONE_NUMBER_ID=your_phone_id
WHATSAPP_BUSINESS_API_TOKEN=your_token

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
# Sentry
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_ENVIRONMENT=development

# Datadog
DATADOG_API_KEY=your_api_key
DATADOG_APP_KEY=your_app_key
DATADOG_SITE=datadoghq.com

# ============================================================================
# WEARABLES INTEGRATION
# ============================================================================
# Apple HealthKit
APPLE_HEALTHKIT_TEAM_ID=your_team_id
APPLE_HEALTHKIT_KEY_ID=your_key_id
APPLE_HEALTHKIT_PRIVATE_KEY=your_private_key

# Fitbit
FITBIT_CLIENT_ID=your_client_id
FITBIT_CLIENT_SECRET=your_client_secret

# ============================================================================
# GITHUB & DEPLOYMENT
# ============================================================================
GITHUB_TOKEN=ghp_xxxx
GITHUB_REPOSITORY=your-org/aquarios

# DigitalOcean
DIGITALOCEAN_TOKEN=dop_xxxx
DIGITALOCEAN_APP_ID_PROD=your_app_id_prod
DIGITALOCEAN_APP_ID_STAGING=your_app_id_staging

# ============================================================================
# SLACK (Notifications)
# ============================================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/TXXXX/BXXXX/XXXX
SLACK_CHANNEL=#engineering
SLACK_BOT_TOKEN=xoxb-xxxx

# ============================================================================
# APPLICATION-SPECIFIC
# ============================================================================
# APP
APP_NAME=AquariOS
APP_VERSION=2.0000.1
APP_URL=https://aquarios.app
API_BASE_URL=https://api.aquarios.app

# Features (Feature Flags)
ENABLE_WEARABLE_SYNC=true
ENABLE_VOICE_ANALYSIS=true
ENABLE_COMMUNITY_REACTIONS=true
ENABLE_TOKENOMICS=true
ENABLE_B2B=false  # Enable in Phase 3

# Security
ALLOW_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://aquarios.app
BCRYPT_ROUNDS=12
SESSION_TIMEOUT_HOURS=24

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================
SEED_DATABASE=false
USE_FAKE_PAYMENTS=false
LOG_SQL_QUERIES=false
