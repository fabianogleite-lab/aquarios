# Pacote D — Business Agent · variáveis de ambiente.
# Preencher SÓ na VM Oracle (systemd EnvironmentFile). NUNCA commitar valores reais.
# A migration 30 usa service_role (bypassa RLS); o cliente jamais vê esta chave.

SUPABASE_URL=https://agebsmjsjrmazbozphnh.supabase.co
SUPABASE_SERVICE_KEY=        # service_role secret (Supabase > Project Settings > API)

META_APP_SECRET=             # App secret — verifica X-Hub-Signature-256 e signed_request
META_VERIFY_TOKEN=           # string que você define; usada no GET /webhook
META_TOKEN=                  # token de envio da Graph API (System User / permanent)
PHONE_ID=                    # WhatsApp Business phone number ID
WA_BUSINESS_PHONE=5511999999999   # número E.164 sem '+' usado no wa.me do widget

SLACK_APPROVAL_URL=          # Incoming Webhook do Slack (HumanLayer)
PUBLIC_BASE=https://podiumtec.com.br   # base das URLs de status de exclusão
